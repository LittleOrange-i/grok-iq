# Bootstrap settings (restart required)
TZ=Asia/Shanghai
GAM_HOST=0.0.0.0
GAM_PORT=8090
GAM_DATABASE_PATH=./data/monitor.db
GAM_RUNTIME_SECRET_KEY=
# Leave empty to generate monitor.jwt.key beside the database (minimum 32 bytes when set).
GAM_JWT_SECRET_KEY=
# JWT lifetime in seconds; values shorter than 7 days are rejected.
GAM_JWT_TTL_SECONDS=604800
GAM_CORS_ORIGINS=https://monitor.lvyrix.com,http://localhost:8091,http://127.0.0.1:8091

# Initial runtime values. After first start these can be maintained in the UI.
GAM_GROK2API_BASE_URL=http://127.0.0.1:8000
GAM_GROK2API_ADMIN_USERNAME=
GAM_GROK2API_ADMIN_PASSWORD=
GAM_GROK2API_HTTP_IMPERSONATE=chrome

GAM_GROK_REGISTER_WEBHOOK_TOKEN=
GAM_INITIAL_PROBE_ON_REGISTER=false
GAM_REGISTER_PROBE_PROFILE_IDS=["quality-marker"]
GAM_REGISTER_PROBE_EXECUTION_MODE=chat
GAM_REGISTER_PROBE_ROUNDS=3
GAM_REGISTER_PROBE_PROXY_TARGETS=[{"kind":"direct","id":null}]

# WeChat public-platform test account template notifications (runtime settings)
GAM_WECHAT_NOTIFICATION_ENABLED=false
GAM_WECHAT_APP_ID=
GAM_WECHAT_APP_SECRET=
GAM_WECHAT_OPENID=
GAM_WECHAT_TEMPLATE_ID=

GAM_SCHEDULER_ENABLED=true
GAM_SCHEDULER_TIMEZONE=UTC
GAM_SCHEDULER_MISFIRE_GRACE_SECONDS=300
GAM_RECOVERY_CRON=*/5 * * * *

GAM_PROBE_WORKER_CONCURRENCY=2
GAM_PROBE_QUEUE_LIMIT=10000
GAM_PROBE_STEP_DELAY_SECONDS=0.6
GAM_PROBE_TRANSIENT_RETRY_ATTEMPTS=2
GAM_PROBE_TRANSIENT_RETRY_BASE_SECONDS=5
GAM_PROBE_TRANSIENT_RETRY_MAX_SECONDS=30
GAM_PROBE_ROUTE_PREFIX=gam-probe
GAM_PROBE_DIAGNOSTIC_PRIORITY=-1000000

GAM_ANALYSIS_WINDOW_HOURS=168
GAM_DEGRADATION_TPS=150
GAM_STRONG_DEGRADATION_TPS=500
GAM_CONSECUTIVE_ANOMALIES=3
GAM_CROSS_EGRESS_MIN=2
GAM_BUFFER_FIRST_TOKEN_SHARE=0.85
GAM_MIN_GENERATION_MS=250
GAM_MINIMUM_OUTPUT_TOKENS=32
GAM_AUTO_QUARANTINE=false
GAM_QUARANTINE_MINUTES=30

# Docker Compose images and published ports
GAM_BACKEND_IMAGE=ghcr.io/kaibush/grok-account-monitor-backend:latest
GAM_FRONTEND_IMAGE=ghcr.io/kaibush/grok-account-monitor-frontend:latest
GAM_WEB_PORT=8091
GAM_API_PORT=8090
